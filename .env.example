# Postgres (Railway la genera automáticamente al añadir el plugin "Postgres";
# copia su valor de ${{Postgres.DATABASE_URL}} en las variables del servicio web)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Genera uno nuevo con: openssl rand -base64 32
NEXTAUTH_SECRET="reemplaza-esto"

# URL pública del servicio en Railway (Settings > Networking > Generate Domain)
NEXTAUTH_URL="https://tu-app.up.railway.app"

# Igual a NEXTAUTH_URL en producción
NEXT_PUBLIC_API_URL="https://tu-app.up.railway.app"

NODE_ENV="production"
